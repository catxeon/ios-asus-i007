+extern ppnum_t pmap_find_phys(pmap_t pmap, addr64_t va);
+extern uint32_t sweet_log_copy(uint64_t *pos, char *out, uint32_t max);   /* bsd/dev/sweet_ufs.c */
+extern uint64_t sweet_log_position(void);
+void asus_usb_start(void);
+
+#define GCC_PA                  0x00100000
+#define GCC_SIZE                0x00020000
+#define GCC_USB30_PRIM_GDSCR    0x0f004         /* bit 31: power on */
+#define CBCR_CLK_OFF            (1u << 31)
+
+static const struct {
+	const char *name;
+	uint32_t    off;
+} usb_cbcr[] = {
+	{ "master", 0x0f010 },
+	{ "sleep", 0x0f018 },
+	{ "mock-utmi", 0x0f01c },
+	{ "cfg-noc-axi", 0x0f07c },
+	{ "aggre-axi", 0x0f080 },
