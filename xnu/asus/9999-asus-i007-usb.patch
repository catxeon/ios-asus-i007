+/*
+ * ASUS I007: USB device mode with a CDC-NCM network function (ue0) and the
+ * live console log over it. The same scheme as sweet's bsd/dev/sweet_usb.c
+ * (xnu/patches 0072-0077: probe, ep0, VBUS override, CDC-ECM, rx mbuf, live
+ * log), moved to the SM8350 and to NCM, because Windows has no CDC-ECM
+ * driver: its own UsbNcm.sys binds to the Microsoft OS compatible ID
+ * "WINNCM" (usbncm.inf: USB\MS_COMP_WINNCM), which the device names in an
+ * MS OS 1.0 Extended Compat ID descriptor.
+ *
+ * Boot-arg asususb: 0 (default) nothing, 1 report the controller's state
+ * only, 2 also run the USB device. asususblog=0 turns the live log off.
+ *
+ * Hardware (Android's device tree on this phone): ssusb@a600000
+ * qcom,dwc-usb3-msm (core_base 0x0a600000, 1 MiB, with the Qualcomm
+ * QSCRATCH block at +0xf8800), dwc3@a600000 snps,dwc3 (maximum-speed
+ * super-speed-plus, dis_u2_susphy_quirk, dma-coherent, behind the SMMU like
+ * the UFS host), HS PHY snps femto at 0x088e3000, SS PHY QMP at 0x088e8000.
+ * ABL runs fastboot on this controller, so after `fastboot boot` it is
+ * powered, clocked and set up; only the device controller is restarted
+ * here, at high speed (USB 2.0, the HS PHY ABL left running). Register
+ * reads of the DWC3 happen only while GCC says its power domain and master
+ * clock are on (a gated block would hang the bus). GCC offsets: Linux
+ * gcc-sm8250.c / gcc-sm8350.c (usb30_prim_gdsc 0xf004).
+ *
+ * Network: the phone is 169.254.7.2/16 (link-local, so a Windows PC that
+ * gets no DHCP on the adapter is on the same net with its own 169.254.x.y
+ * and nothing needs setting up there). Live log: the phone listens on UDP
+ * 5140; whoever sends it a datagram gets the console from then on (the
+ * last 64 KiB first; "all" asks for the whole 4 MiB ring, "tail" for the
+ * last 64 KiB again). Replies to a datagram the PC sent pass its firewall.
+ * tools/asus-usbnet.py is the PC side.
+ *
+ * Control transfers, endpoint commands and TRBs follow the Synopsys DWC3
+ * databook as Linux drivers/usb/dwc3 uses it (gadget.c, ep0.c); NCM 1.0
+ * (NTB16 only) as Linux drivers/usb/gadget/function/f_ncm.c.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET) && defined(ASUS_I007)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/socket.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
