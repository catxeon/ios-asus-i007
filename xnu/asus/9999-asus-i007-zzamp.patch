 #define MAX_CPUS                       8
+#if defined(ASUS_I007)
+/* SM8350: Cortex-A55 E cluster (boot, cpu0-3) and A78/X1 P cluster (cpu4-7); see SWEET.h. */
+#define MAX_CPU_CLUSTERS               2
+#else
 #define MAX_CPU_CLUSTERS               1
+#endif
 
