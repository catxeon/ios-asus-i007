+/*
+ * ASUS I007 userland services (optional profile --userland).
+ *
+ * Policy "Sandbox": libsystem_sandbox calls __mac_syscall("Sandbox", op,
+ * arg). Without a MAC policy of that name every call fails with ENOPOLICY,
+ * and launchd answers Mach lookups with "error = 159: Sandbox restriction"
+ * (QEMU: backboardd could not reach logd, notifyd, iohideventsystem or
+ * containermanagerd). This profile runs without a sandbox, as the sweet
+ * port did with its patch 0050: checks are allowed and profile init is
+ * accepted; operations that must return data (container path, extension
+ * issue/consume, container expected) fail with ENOENT. The first use of
+ * each operation number is logged. Nothing else is granted: code signature
+ * and page validation and the no-entitlements AMFI provider are unchanged.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <kern/debug.h>
+#include <mach/kern_return.h>
+#include <mach/mach_types.h>
+#include <sys/errno.h>
+#include <sys/proc.h>
+#include <security/mac_policy.h>
+#include <sys/systm.h>
+#include <kern/kalloc.h>
+#include <pexpert/device_tree.h>
+#include <sys/codesign.h>
+#include <sys/mount.h>
+#include <sys/ubc_internal.h>
+#include <sys/vnode.h>
+#include <sys/priv.h>
+#include <libkern/OSAtomic.h>
+
+static uint64_t asus_sandbox_seen;
+
+/*
+ * Sweet 0064. Privileges for non-root processes come from MAC policies
+ * (priv_check_cred -> mac_priv_grant); on iOS Sandbox/AMFI grant them. Without a
+ * grant UIKit apps fail in CoreAnimation setup: work_interval_create(CA_CLIENT)
+ * needs PRIV_WORK_INTERVAL ("Failed to create work interval", SpringBoard).
+ * Grant that one; log the first denial of each other privilege per process.
+ */
+#define ASUS_PRIV_LOG_MAX       64
+static struct {
+	int  priv;
+	char name[20];
+} asus_priv_logged[ASUS_PRIV_LOG_MAX];
+static int asus_priv_logged_count;
+
+static int
+asus_sandbox_priv_grant(kauth_cred_t cred __unused, int priv)
+{
+	if (priv == PRIV_WORK_INTERVAL) {
+		return 0;
+	}
+	char name[20];
+	proc_selfname(name, sizeof(name));
+	for (int i = 0; i < asus_priv_logged_count; i++) {
+		if (asus_priv_logged[i].priv == priv &&
+		    strncmp(asus_priv_logged[i].name, name, sizeof(name)) == 0) {
+			return EPERM;
+		}
+	}
+	if (asus_priv_logged_count < ASUS_PRIV_LOG_MAX) {
+		asus_priv_logged[asus_priv_logged_count].priv = priv;
+		strlcpy(asus_priv_logged[asus_priv_logged_count].name, name, sizeof(name));
+		asus_priv_logged_count++;
+		printf("ASUS Sandbox: %s privilege %d denied\n", name, priv);
+	}
+	return EPERM;
+}
+
+/*
+ * Sandbox extensions (libsystem_sandbox, iOS 16.7). Issue, op 5: { u64 class (user
+ * string), type (0 file, 3 generic, ...), path or name, flags, token buffer (0x800 bytes,
+ * the library mallocs it), pid, u32 }; the kernel writes the token string there and the
+ * library returns the buffer. Consume, op 6: { u64 token, its length + 1, user pointer to
+ * an i64 handle }; release (op 7, handle) and the rest succeed by default. Nothing is
+ * enforced here, so a token is only an opaque string: what matters is that issuing works.
+ * tccd grants kTCCServicePhotos to assetsd by entitlement but replied "Failed to issue
+ * Sandbox Extension" (kTCCErrorDomain 6) while op 5 failed with ENOENT, and assetsd threw
+ * "assetsd requires TCCPhotosService access" (84 crashes per boot, image 0129).
+ */
+static int64_t asus_sandbox_ext_issued, asus_sandbox_ext_consumed;
+int asus_sandbox_container_path(user_addr_t arg);       /* asus_sandbox_container.c */
+
+static int
+asus_sandbox_extension_issue(user_addr_t arg)
+{
+	uint64_t a[7];
+	char cls[96], token[160];
+	size_t done;
+	int64_t n;
+	int error = copyin(arg, a, sizeof(a));
+
+	if (error != 0) {
+		return error;
+	}
+	if (a[4] == 0) {
+		return EINVAL;
+	}
+	cls[0] = '\0';
+	if (a[0] == 0 || copyinstr((user_addr_t)a[0], cls, sizeof(cls), &done) != 0) {
+		strlcpy(cls, "?", sizeof(cls));
+	}
+	n = OSIncrementAtomic64(&asus_sandbox_ext_issued) + 1;
+	snprintf(token, sizeof(token), "%016llx;00;asus;%llu;%s", (unsigned long long)n, a[1], cls);
+	if (n <= 32) {
+		char name[32];
+		proc_selfname(name, sizeof(name));
+		printf("ASUS Sandbox: %s issues extension %s (type %llu)\n", name, cls, a[1]);
+	}
+	return copyout(token, (user_addr_t)a[4], strlen(token) + 1);
+}
+
+static int
+asus_sandbox_extension_consume(user_addr_t arg)
+{
+	uint64_t a[3];
+	int64_t handle;
+	int error = copyin(arg, a, sizeof(a));
+
+	if (error != 0) {
+		return error;
+	}
+	if (a[2] == 0) {
+		return EINVAL;
+	}
+	handle = OSIncrementAtomic64(&asus_sandbox_ext_consumed) + 1;
+	return copyout(&handle, (user_addr_t)a[2], sizeof(handle));
+}
+
+static int
+asus_sandbox_syscall(struct proc *p, int call, user_addr_t arg)
+{
+	if (call >= 0 && call < 64 && !(asus_sandbox_seen & (1ULL << call))) {
+		char name[32];
+		asus_sandbox_seen |= 1ULL << call;
+		proc_name(proc_pid(p), name, sizeof(name));
+		printf("ASUS Sandbox: %s op %d\n", name, call);
+	}
+	switch (call) {
+	case 5:         /* extension issue */
+		return asus_sandbox_extension_issue(arg);
+	case 6:         /* extension consume */
+		return asus_sandbox_extension_consume(arg);
+	case 4:         /* container path (pid): CFFIXED_USER_HOME, else ENOENT */
+		return asus_sandbox_container_path(arg);
+	case 0x43:      /* container expected */
+		return ENOENT;
+	default:
+		return 0;
+	}
+}
+
+static const struct mac_policy_ops asus_sandbox_ops = {
+	.mpo_policy_syscall = asus_sandbox_syscall,
+	.mpo_priv_grant = asus_sandbox_priv_grant,
+};
+
+static struct mac_policy_conf asus_sandbox_conf = {
+	.mpc_name = "Sandbox",
+	.mpc_fullname = "ASUS permissive sandbox stand-in",
+	.mpc_ops = &asus_sandbox_ops,
+};
+
+/*
+ * Static trust cache. On iOS, iBoot hands the OS image's static trust cache
+ * to the kernel and AMFI marks every binary whose code directory hash is in
+ * it as a platform binary. The ASUS loader passes the stock trust cache
+ * (version 2: 24-byte header, sorted 24-byte entries cdhash[20], hash type,
+ * flags, 2 reserved) in /chosen/asus-static-trust-cache. It is copied at
+ * boot; without the property nothing is trusted here. Only binaries on the
+ * root filesystem are considered, the hash type must match, and page hash
+ * validation stays with the kernel.
+ */
+static uint8_t *asus_tc_entries;
+static uint32_t asus_tc_count;
+static uint32_t asus_tc_logged;
+
+static void
+asus_trust_cache_init(void)
+{
+	DTEntry chosen;
+	void const *prop;
+	unsigned int size;
+	uint32_t tc_version, tc_count;
+
+	if (SecureDTLookupEntry(NULL, "/chosen", &chosen) != kSuccess ||
+	    SecureDTGetProperty(chosen, "asus-static-trust-cache", &prop, &size) != kSuccess) {
+		printf("ASUS TRUST: no static trust cache in /chosen\n");
+		return;
+	}
+	if (size < 24) {
+		printf("ASUS TRUST: trust cache too small (%u)\n", size);
+		return;
+	}
+	memcpy(&tc_version, prop, sizeof(tc_version));
+	memcpy(&tc_count, (const uint8_t *)prop + 20, sizeof(tc_count));
+	if (tc_version != 2 || (uint64_t)size != 24 + 24ULL * tc_count) {
+		printf("ASUS TRUST: rejected trust cache (version %u, %u entries, %u bytes)\n",
+		    tc_version, tc_count, size);
+		return;
+	}
+	asus_tc_entries = kalloc_data(24ULL * tc_count, Z_WAITOK);
+	if (asus_tc_entries == NULL) {
+		return;
+	}
+	memcpy(asus_tc_entries, (const uint8_t *)prop + 24, 24ULL * tc_count);
+	asus_tc_count = tc_count;
+	printf("ASUS TRUST: static trust cache v2, %u entries\n", tc_count);
+}
+
+static bool
+asus_tc_contains(const uint8_t *cdhash, uint8_t hash_type)
+{
+	uint32_t lo = 0, hi = asus_tc_count;
+	while (lo < hi) {
+		uint32_t mid = lo + (hi - lo) / 2;
+		const uint8_t *entry = asus_tc_entries + 24ULL * mid;
+		int c = memcmp(entry, cdhash, CS_CDHASH_LEN);
+		if (c == 0) {
+			return entry[CS_CDHASH_LEN] == hash_type;
+		}
+		if (c < 0) {
+			lo = mid + 1;
+		} else {
+			hi = mid;
+		}
+	}
+	return false;
+}
+
+/*
+ * The same trust cache, any hash type, for AppleMobileFileIntegrity's user client
+ * (iokit/Kernel/arm/AsusMobileFileIntegrity.cpp): ExtensionFoundation asks it whether the
+ * detached signature of /System/Library/xpc/extensions.plist is in the trust cache.
+ */
+bool asus_trust_cache_has(const uint8_t *cdhash);
+bool
+asus_trust_cache_has(const uint8_t *cdhash)
+{
+	uint32_t lo = 0, hi = asus_tc_count;
+	while (lo < hi) {
+		uint32_t mid = lo + (hi - lo) / 2;
+		int c = memcmp(asus_tc_entries + 24ULL * mid, cdhash, CS_CDHASH_LEN);
+		if (c == 0) {
+			return true;
+		}
+		if (c < 0) {
+			lo = mid + 1;
+		} else {
+			hi = mid;
+		}
+	}
+	return false;
+}
+
+static int
+asus_trust_check_signature(struct vnode *vp, __unused struct label *label,
+    __unused cpu_type_t cpu_type, struct cs_blob *cs_blob,
+    unsigned int *cs_flags, __unused unsigned int *signer_type,
+    __unused int flags, __unused unsigned int platform,
+    __unused char **failure, __unused size_t *failure_len)
+{
+	mount_t mp = vnode_mount(vp);
+	if (asus_tc_count == 0 || mp == NULL || (vfs_flags(mp) & MNT_ROOTFS) == 0) {
+		return 0;
+	}
+	if (asus_tc_contains(cs_blob->csb_cdhash, csblob_get_hashtype(cs_blob))) {
+		*cs_flags |= CS_SIGNED | CS_PLATFORM_BINARY;
+		if (asus_tc_logged < 64) {
+			const char *name = vnode_getname(vp);
+			asus_tc_logged++;
+			printf("ASUS TRUST: platform binary %s\n", name ? name : "?");
+			if (name) {
+				vnode_putname(name);
+			}
+		}
+	}
+	return 0;
+}
+
+static const struct mac_policy_ops asus_trust_ops = {
+	.mpo_vnode_check_signature = asus_trust_check_signature,
+};
+
+static struct mac_policy_conf asus_trust_conf = {
+	.mpc_name = "ASUS TRUST",
+	.mpc_fullname = "ASUS static trust cache platform binaries",
+	.mpc_ops = &asus_trust_ops,
+};
+
+/*
+ * Entitlements: attach each new signature's XML entitlements (checked against
+ * its code directory) before exec decisions are made, like AMFI's hook. The
+ * read-only copy (csb_ro_addr) is revalidation and already has them.
+ */
+void asus_amfi_attach_entitlements(struct cs_blob *code_signing_blob);    /* sweet_amfi.c */
+
+static int
+asus_entitlements_check_signature(__unused struct vnode *vp, __unused struct label *label,
+    __unused cpu_type_t cpu_type, struct cs_blob *cs_blob,
+    __unused unsigned int *cs_flags, __unused unsigned int *signer_type,
+    __unused int flags, __unused unsigned int platform,
+    __unused char **failure, __unused size_t *failure_len)
+{
+	if (cs_blob != cs_blob->csb_ro_addr && cs_blob->csb_entitlements == NULL) {
+		asus_amfi_attach_entitlements(cs_blob);
+	}
+	return 0;
+}
+
+static const struct mac_policy_ops asus_entitlements_ops = {
+	.mpo_vnode_check_signature = asus_entitlements_check_signature,
+};
+
+static struct mac_policy_conf asus_entitlements_conf = {
+	.mpc_name = "ASUS ENTITLEMENTS",
+	.mpc_fullname = "ASUS XML entitlements from code signatures",
+	.mpc_ops = &asus_entitlements_ops,
+};
+
+void asus_userland_register(void);
+void
+asus_userland_register(void)
+{
+	static mac_policy_handle_t handle, trust_handle, ent_handle;
+	int error = mac_policy_register(&asus_sandbox_conf, &handle, NULL);
+	printf("ASUS Sandbox: permissive policy %s (%d)\n",
+	    error ? "NOT registered" : "registered", error);
+	error = mac_policy_register(&asus_entitlements_conf, &ent_handle, NULL);
+	printf("ASUS AMFI: XML entitlements policy %s (%d)\n",
+	    error ? "NOT registered" : "registered", error);
+	asus_trust_cache_init();
+	if (asus_tc_count) {
+		error = mac_policy_register(&asus_trust_conf, &trust_handle, NULL);
+		printf("ASUS TRUST: policy registration %d\n", error);
+	}
+}
