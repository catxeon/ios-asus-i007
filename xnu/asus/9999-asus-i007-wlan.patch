+#define GCC_PCIE_0_BCR          0x6b000
+#define GCC_PCIE_0_GDSCR        0x6b004
+#define GCC_PCIE_0_PHY_BCR      0x6c01c
+#define GCC_PCIE_0_SLV_Q2A_CBCR 0x6b010
+#define GCC_PCIE_0_SLV_CBCR     0x6b014
