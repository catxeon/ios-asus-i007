+#define GCC_VOTE_1              0x52008         /* slv (0), mstr (1), cfg ahb (2), aux (3), pipe (4), q2a (5) */
+#define CBCR_OFF                (1u << 31)
+#define GDSC_PWR_ON             (1u << 31)
+
+static vm_offset_t gcc;
+
+static bool
+gcc_branch_on(const char *name, uint32_t cbcr)
+{
+	uint32_t v = 0;
+	for (int i = 0; i < 200; i++) {
+		v = rd(gcc, cbcr);
+		if (!(v & CBCR_OFF)) {
+			return true;
+		}
+		delay(10);
+	}
+	printf("ASUS WLAN: clock %s still off (CBCR %#x)\n", name, v);
+	return false;
+}
