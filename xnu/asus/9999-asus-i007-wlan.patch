+/* ---- TLMM ---- */
+
+#define TLMM_PA         0x0f100000ULL
+#define TLMM_SIZE       0x000cc000      /* 204 GPIOs */
+#define GPIO_CFG(n)     (0x1000u * (n))
+#define GPIO_IO(n)      (0x1000u * (n) + 4)
+#define CFG_PULL_DOWN   1u
+#define CFG_PULL_UP     3u
+#define CFG_FUNC(f)     ((uint32_t)(f) << 2)
+#define CFG_DRV(ma)     ((uint32_t)((ma) / 2 - 1) << 6)
+#define CFG_OE          (1u << 9)
+
+static vm_offset_t tlmm;
+
+static void
+gpio_out(unsigned n, int value, unsigned ma, uint32_t pull)
+{
+	wr(tlmm, GPIO_IO(n), value ? 2u : 0u);
+	wr(tlmm, GPIO_CFG(n), CFG_FUNC(0) | CFG_DRV(ma) | pull | CFG_OE);
+}
+
+static int
+gpio_in(unsigned n)
+{
+	return rd(tlmm, GPIO_IO(n)) & 1;
+}
