+++ b/bsd/dev/asus_wlan.c
@@ -0,0 +1,694 @@
+/*
+ * ASUS I007: Wi-Fi, stage A - power the QCA6490 and bring up its PCIe link.
+ *
+ * The phone's Wi-Fi is a Qualcomm QCA6490 (PCI 17cb:1103) behind the PCIe0 root
+ * port of the SM8350. ABL never touches PCIe, so everything starts cold:
+ *
+ *   1. RPMh votes (apps RSC, HLOS DRV 2, active TCS 0; the touch power of
+ *      iokit/Kernel/arm/AsusPhoneInput.cpp uses TCS 1) for the rails of the
+ *      Android DT: qcom,cnss-qca6490 vdd-wlan-aon pmr735a_s2 "smpe2" 0.95 V, dig
+ *      pm8350_s11 "smpb11" 0.95 V, rfa1 pm8350c_s1 "smpc1" 1.88 V, rfa2 pm8350_s12
+ *      "smpb12" 1.35 V, antenna switch pmr735a_l7 "ldoe7" 2.8 V (vdd-wlan-io, 1.8 V,
+ *      is not an RPMh node: the always-on system 1.8 V); qcom,pcie@1c00000
+ *      vreg-0p9 pm8350_l5 "ldob5" 0.88 V, vreg-1p8 pm8350_l6 "ldob6" 1.2 V;
+ *   2. TLMM: WLAN_EN GPIO 64 high (cnss_wlan_en_active: 16 mA, pull-up), the
+ *      ASUS antenna switch GPIO 148 high, PERST GPIO 94 low (asserted), CLKREQ
+ *      GPIO 95 to pcie0_clkreqn, WAKE GPIO 96 input; SW_CTRL GPIO 153 is read;
+ *   3. GCC (offsets: Linux gcc-sm8350.c): pcie_0_gdsc, the PCIe0 branch votes,
+ *      the 100 MHz PHY rate-change clock, clkref, block resets;
+ *   4. PARF as Linux pcie-qcom.c qcom_pcie_init_2_7_0 (cfg_1_9_0 = sm8350), the
+ *      QMP PHY with the DT's qcom,phy-sequence (75 writes ending in SW_RESET 0 /
+ *      START_CTRL 3), the pipe clock from the PHY, PHY ready (PCS status 0x214
+ *      bit 6 clear);
+ *   5. PERST released 100 ms after power, root port bus numbers, LTSSM_EN, link
+ *      up (DLL active), then one iATU CFG0 window and the endpoint's config space.
+ *
+ * Every register block is touched only after the clocks it needs report on; the
+ * endpoint's config space only with the link up (a down link aborts the access).
+ * Boot-arg asuswlan: 0 (default) nothing, 1 this stage, 2 also stage B0 (SMMU,
+ * BAR0 and the MHI registers, see wl_stage_b0). asuswlandelay=N seconds
+ * before it starts (default 20, after the touch power). Everything is logged
+ * "ASUS WLAN:" (with asususb=2 it arrives live over USB).
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET) && defined(ASUS_I007)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+#include <libkern/libkern.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+void asus_wlan_start(void);
+
+static int wl_chan;
+
+static void
+wl_sleep_ms(unsigned ms)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&wl_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static inline uint32_t
+rd(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile ("dmb oshld" ::: "memory");
+	return v;
+}
+
+static inline void
+wr(vm_offset_t base, uint32_t off, uint32_t v)
+{
+	*(volatile uint32_t *)(base + off) = v;
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+static inline void
+setbits(vm_offset_t base, uint32_t off, uint32_t set, uint32_t clear)
+{
+	wr(base, off, (rd(base, off) & ~clear) | set);
+}
+
+/* ---- RPMh (cmd-db + active TCS 0 of the apps RSC DRV 2; as AsusPhoneInput::rpmhSend) ---- */
+
+#define CMD_DB_PA       0x80860000ULL
+#define CMD_DB_SIZE     0x20000
+#define RSC_DRV2_PA     0x18220000ULL
+#define RSC_DRV2_SIZE   0x10000
+#define TCS_BASE        0xd00
+#define TCS_STRIDE      0x2a0
+#define TCS_ID          0u
+#define TCS_REG(r)      (TCS_BASE + TCS_STRIDE * TCS_ID + (r))
+#define TCS_CMD(r, j)   (TCS_REG(r) + 20 * (j))
+#define VRM_VOLTAGE     0x0
+#define VRM_ENABLE      0x4
+#define VRM_MODE        0x8
+#define PMIC5_LDO_HPM   7
+
+static uint32_t
+cmd_db_addr(vm_offset_t db, const char *name)
+{
+	const uint8_t *p = (const uint8_t *)db;
+	char id[9] = { 0 };
+	strlcpy(id, name, sizeof(id));
+	for (unsigned h = 0; h < 8; h++) {
+		const uint8_t *rh = p + 8 + 16 * h;
+		unsigned hoff = rh[2] | (rh[3] << 8), cnt = rh[6] | (rh[7] << 8);
+		for (unsigned j = 0; j < cnt; j++) {
+			const uint8_t *e = p + 144 + hoff + 24 * j;
+			if (e + 24 > p + CMD_DB_SIZE) {
+				break;
+			}
+			if (memcmp(e, id, 8) == 0) {
+				return e[16] | (e[17] << 8) | (e[18] << 16) | ((uint32_t)e[19] << 24);
+			}
+		}
+	}
+	return 0;
+}
+
+static bool
+rpmh_send(vm_offset_t drv, const uint32_t *addr, const uint32_t *data, unsigned n)
+{
+	if (!rd(drv, TCS_REG(0x18))) {          /* RSC_DRV_STATUS: 0 = busy */
+		printf("ASUS WLAN: RPMh TCS %u busy (control %#x enable %#x)\n", TCS_ID,
+		    rd(drv, TCS_REG(0x14)), rd(drv, TCS_REG(0x1c)));
+		return false;
+	}
+	wr(drv, TCS_BASE + 0x08, 1u << TCS_ID);  /* IRQ_CLEAR */
+	wr(drv, TCS_REG(0x1c), 0);              /* CMD_ENABLE */
+	uint32_t mask = 0;
+	for (unsigned j = 0; j < n; j++) {
+		wr(drv, TCS_CMD(0x30, j), 8u | (1u << 8) | (1u << 16));  /* 4 bytes, write, response */
+		wr(drv, TCS_CMD(0x34, j), addr[j]);
+		wr(drv, TCS_CMD(0x38, j), data[j]);
+		mask |= 1u << j;
+	}
+	wr(drv, TCS_REG(0x10), mask);           /* CMD_WAIT_FOR_CMPL */
+	wr(drv, TCS_REG(0x1c), mask);           /* CMD_ENABLE */
+	wr(drv, TCS_BASE + 0x00, rd(drv, TCS_BASE + 0x00) | (1u << TCS_ID));
+	uint32_t ctl = rd(drv, TCS_REG(0x14));  /* CONTROL: AMC mode, then trigger */
+	ctl &= ~(1u << 24);
+	wr(drv, TCS_REG(0x14), ctl);
+	ctl &= ~(1u << 16);
+	wr(drv, TCS_REG(0x14), ctl);
+	ctl |= 1u << 16;
+	wr(drv, TCS_REG(0x14), ctl);
+	ctl |= 1u << 24;
+	wr(drv, TCS_REG(0x14), ctl);
+	bool done = false;
+	for (unsigned i = 0; i < 2000 && !done; i++) {
+		done = rd(drv, TCS_BASE + 0x04) & (1u << TCS_ID);   /* IRQ_STATUS */
+		if (!done) {
+			delay(10);
+		}
+	}
+	for (unsigned j = 0; j < n; j++) {
+		printf("ASUS WLAN: RPMh cmd %u addr %#x data %u status %#x\n", j, addr[j], data[j],
+		    rd(drv, TCS_CMD(0x3c, j)));
+	}
+	wr(drv, TCS_BASE + 0x08, 1u << TCS_ID);
+	wr(drv, TCS_REG(0x1c), 0);
+	wr(drv, TCS_REG(0x10), 0);
+	wr(drv, TCS_REG(0x14), rd(drv, TCS_REG(0x14)) & ~((1u << 24) | (1u << 16)));
+	return done;
+}
+
+static const struct {
+	const char *res;
+	uint32_t    mv;
+	bool        ldo;            /* LDOs also get high-power mode */
+} wl_rails[] = {
+	{ "smpe2", 950, false },        /* vdd-wlan-aon, pmr735a S2 */
+	{ "smpb11", 950, false },       /* vdd-wlan-dig, pm8350 S11 */
+	{ "smpc1", 1880, false },       /* vdd-wlan-rfa1, pm8350c S1 */
+	{ "smpb12", 1350, false },      /* vdd-wlan-rfa2, pm8350 S12 */
+	{ "ldoe7", 2800, true },        /* wlan-ant-switch, pmr735a L7 */
+	{ "ldob5", 880, true },         /* PCIe0 PHY 0.9 V, pm8350 L5 */
+	{ "ldob6", 1200, true },        /* PCIe0 PHY 1.2 V, pm8350 L6 */
+};
+
+static bool
+wl_power_rails(void)
+{
+	vm_offset_t db = ml_io_map(CMD_DB_PA, CMD_DB_SIZE);
+	vm_offset_t drv = ml_io_map(RSC_DRV2_PA, RSC_DRV2_SIZE);
+	uint32_t addr[16], data[16];
+	unsigned n = 0;
+	bool ok = true;
+
+	if (db == 0 || drv == 0) {
+		printf("ASUS WLAN: cmd-db / RSC map failed\n");
+		return false;
+	}
+	for (unsigned i = 0; i < sizeof(wl_rails) / sizeof(wl_rails[0]); i++) {
+		uint32_t a = cmd_db_addr(db, wl_rails[i].res);
+		printf("ASUS WLAN: rail %-6s at %#x: %u mV\n", wl_rails[i].res, a, wl_rails[i].mv);
+		if (a == 0) {
+			ok = false;
+			continue;
+		}
+		/* voltage, (mode), enable; at most 16 commands per TCS: send in two batches */
+		if (n + 3 > 16) {
+			ok &= rpmh_send(drv, addr, data, n);
+			n = 0;
+		}
+		addr[n] = a + VRM_VOLTAGE; data[n++] = wl_rails[i].mv;
+		if (wl_rails[i].ldo) {
+			addr[n] = a + VRM_MODE; data[n++] = PMIC5_LDO_HPM;
+		}
+		addr[n] = a + VRM_ENABLE; data[n++] = 1;
+	}
+	if (n) {
+		ok &= rpmh_send(drv, addr, data, n);
+	}
+	return ok;
+}
