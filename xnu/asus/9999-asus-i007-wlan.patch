+static int wl_mode;
+
+/*
+ * Stage B0 (asuswlan=2): what the next stage depends on, read only but for the
+ * endpoint's BAR0 and an iATU MEM window to it.
+ *  - The apps SMMU (qcom,qsmmu-v500 at 0x15000000, DT qcom,skip-init: the
+ *    bootloaders' setup is kept): sCR0 (CLIENTPD = bypass all, USFCFG = fault on
+ *    unmatched streams), the stream match registers and their S2CRs, the ones
+ *    that cover PCIe0's SIDs (iommu-map: 0x1c00 root port, 0x1c01 the endpoint)
+ *    marked. The chip's DMA (MHI rings, firmware images) goes through it.
+ *  - BAR0: size, an address in the MEM window (DT ranges 0x60300000, 61 MiB),
+ *    iATU outbound region 1 (MEM, untranslated), memory space + bus master.
+ *  - MHI (Linux drivers/bus/mhi, as ath11k maps it at BAR0 + 0): MHIREGLEN, MHIVER,
+ *    MHICFG, the doorbell / BHI / BHIe offsets, MHICTRL, MHISTATUS; BHI version,
+ *    execution environment (0 PBL, 1 SBL, 2 AMSS), status, error, serial, HW id.
+ */
+#define SMMU_PA         0x15000000ULL
+#define MEM_WINDOW      0x60300000ULL
+#define MEM_WINDOW_END  0x64000000ULL
+
+static void
+wl_smmu_report(void)
+{
+	vm_offset_t s = ml_io_map(SMMU_PA, 0x1000);
+	if (s == 0) {
+		printf("ASUS WLAN: SMMU map failed\n");
+		return;
+	}
+	uint32_t cr0 = rd(s, 0x00), idr0 = rd(s, 0x20), idr1 = rd(s, 0x24), idr2 = rd(s, 0x28);
+	unsigned nsmr = idr0 & 0xff, valid = 0, shown = 0;
+	printf("ASUS WLAN: SMMU sCR0 %#x (CLIENTPD %u USFCFG %u EXIDENABLE %u) sIDR0 %#x (%u SMRs, "
+	    "EXIDS %u) sIDR1 %#x sIDR2 %#x\n", cr0, cr0 & 1, (cr0 >> 10) & 1, (cr0 >> 3) & 1, idr0, nsmr,
+	    (idr0 >> 8) & 1, idr1, idr2);
+	for (unsigned i = 0; i < nsmr && i < 256; i++) {
+		uint32_t smr = rd(s, 0x800 + 4 * i), s2cr = rd(s, 0xc00 + 4 * i);
+		bool v = (cr0 & (1u << 3)) ? (s2cr & (1u << 10)) != 0 : (smr & (1u << 31)) != 0;
+		if (!v) {
+			continue;
+		}
+		valid++;
+		uint32_t sid = smr & 0xffff, mask = (smr >> 16) & 0x7fff;
+		if (!(cr0 & (1u << 3))) {
+			sid &= 0x7fff;
+		}
+		bool pcie = ((0x1c00 ^ sid) & ~mask & 0xffff) == 0 || ((0x1c01 ^ sid) & ~mask & 0xffff) == 0;
+		if (pcie || shown < 40) {
+			shown++;
+			printf("ASUS WLAN: SMR%u id %#x mask %#x S2CR %#x (type %u cb %u)%s\n", i, sid, mask, s2cr,
+			    (s2cr >> 16) & 3, s2cr & 0xff, pcie ? " <- PCIe0" : "");
+		}
+	}
+	printf("ASUS WLAN: SMMU: %u valid stream matches (%u shown)\n", valid, shown);
+}
+
+static void
+wl_stage_b0(vm_offset_t atu, vm_offset_t conf)
+{
+	wl_smmu_report();
+
+	uint32_t lo0 = rd(conf, 0x10);
+	wr(conf, 0x10, 0xffffffff);
+	wr(conf, 0x14, 0xffffffff);
+	uint32_t lo = rd(conf, 0x10), hi = rd(conf, 0x14);
+	uint64_t size = ~((((uint64_t)hi << 32) | (lo & ~0xfu))) + 1;
+	printf("ASUS WLAN: BAR0 flags %#x, size %#llx (probe %#x %#x)\n", lo0 & 0xf, size, lo, hi);
+	if (size == 0 || size > MEM_WINDOW_END - MEM_WINDOW) {
+		wr(conf, 0x10, lo0);
+		wr(conf, 0x14, 0);
+		return;
+	}
+	uint64_t bar = (MEM_WINDOW + size - 1) & ~(size - 1);
+	if (bar + size > MEM_WINDOW_END) {
+		printf("ASUS WLAN: BAR0 does not fit the MEM window\n");
+		return;
+	}
+	wr(conf, 0x10, (uint32_t)bar);
+	wr(conf, 0x14, (uint32_t)(bar >> 32));
+	/* iATU outbound region 1 (unrolled, 0x200 apart): MEM, untranslated */
+	wr(atu, 0x200 + 0x08, (uint32_t)bar);
+	wr(atu, 0x200 + 0x0c, (uint32_t)(bar >> 32));
+	wr(atu, 0x200 + 0x10, (uint32_t)(bar + size - 1));
+	wr(atu, 0x200 + 0x14, (uint32_t)bar);
+	wr(atu, 0x200 + 0x18, (uint32_t)(bar >> 32));
+	wr(atu, 0x200 + 0x00, 0x0);                     /* MEM */
+	wr(atu, 0x200 + 0x04, 1u << 31);
+	for (int i = 0; i < 100 && !(rd(atu, 0x200 + 0x04) & (1u << 31)); i++) {
+		delay(10);
+	}
+	wr(conf, 0x04, rd(conf, 0x04) | 0x0006);        /* memory space, bus master */
+	printf("ASUS WLAN: BAR0 at %#llx, command %#x, iATU1 ctrl2 %#x\n", bar, rd(conf, 0x04),
+	    rd(atu, 0x200 + 0x04));
+
+	vm_offset_t m = ml_io_map((vm_offset_t)bar, (vm_size_t)MIN(size, 0x80000ULL));
+	if (m == 0) {
+		printf("ASUS WLAN: BAR0 map failed\n");
+		return;
+	}
+	uint32_t bhi = rd(m, 0x28), bhie = rd(m, 0x2c);
+	printf("ASUS WLAN: MHI REGLEN %#x VER %#x CFG %#x CHDBOFF %#x ERDBOFF %#x BHIOFF %#x BHIEOFF %#x "
+	    "CTRL %#x STATUS %#x\n", rd(m, 0x00), rd(m, 0x08), rd(m, 0x10), rd(m, 0x18), rd(m, 0x20), bhi, bhie,
+	    rd(m, 0x38), rd(m, 0x48));
+	if (bhi != 0 && bhi < 0x80000 - 0x80) {
+		printf("ASUS WLAN: BHI version %u.%u EXECENV %#x STATUS %#x ERRCODE %#x ERRDBG %#x %#x %#x "
+		    "SERIAL %#x HWID %#x\n", rd(m, bhi + 0x04), rd(m, bhi + 0x00), rd(m, bhi + 0x28),
+		    rd(m, bhi + 0x2c), rd(m, bhi + 0x30), rd(m, bhi + 0x34), rd(m, bhi + 0x38), rd(m, bhi + 0x3c),
+		    rd(m, bhi + 0x40), rd(m, bhi + 0x4c));
+	}
+}
+
+/* PCI capability offset in the root port's DBI config header, 0 if absent */
+static uint32_t
+dbi_find_cap(vm_offset_t dbi, uint8_t id)
+{
+	uint32_t pos = rd(dbi, 0x34) & 0xfc;
+	for (int i = 0; i < 48 && pos >= 0x40; i++) {
+		uint32_t v = rd(dbi, pos);
+		if ((v & 0xff) == id) {
+			return pos;
+		}
+		pos = (v >> 8) & 0xfc;
+	}
+	return 0;
+}
+
+static void
+wl_pcie_up(void)
+{
+	vm_offset_t parf = ml_io_map(PARF_PA, PARF_SIZE);
+	vm_offset_t phy = ml_io_map(PHY_PA, PHY_SIZE);
+	vm_offset_t dbi = ml_io_map(DBI_PA, DBI_SIZE);
+	vm_offset_t atu = ml_io_map(ATU_PA, ATU_SIZE);
+	vm_offset_t conf = ml_io_map(CONF_PA, CONF_SIZE);
+	uint64_t t0 = mach_absolute_time();
+
+	if (!parf || !phy || !dbi || !atu || !conf) {
+		printf("ASUS WLAN: PCIe0 map failed\n");
+		return;
+	}
+
+	/* GDSC */
+	printf("ASUS WLAN: pcie_0_gdsc GDSCR %#x\n", rd(gcc, GCC_PCIE_0_GDSCR));
+	setbits(gcc, GCC_PCIE_0_GDSCR, 0, 1u);           /* SW_COLLAPSE off */
+	for (int i = 0; i < 100 && !(rd(gcc, GCC_PCIE_0_GDSCR) & GDSC_PWR_ON); i++) {
+		delay(10);
+	}
+	printf("ASUS WLAN: pcie_0_gdsc now %#x (%s)\n", rd(gcc, GCC_PCIE_0_GDSCR),
+	    (rd(gcc, GCC_PCIE_0_GDSCR) & GDSC_PWR_ON) ? "on" : "STILL OFF");
+	if (!(rd(gcc, GCC_PCIE_0_GDSCR) & GDSC_PWR_ON)) {
+		return;
+	}
+
+	/* PHY rate-change clock 100 MHz = GPLL0 even (300 MHz) / 3, aux 19.2 MHz (XO, the reset value) */
+	wr(gcc, GCC_PCIE0_RCHNG_RCGR + 4, (6u << 8) | (2 * 3 - 1));
+	wr(gcc, GCC_PCIE0_RCHNG_RCGR, rd(gcc, GCC_PCIE0_RCHNG_RCGR) | 1u);
+	for (int i = 0; i < 100 && (rd(gcc, GCC_PCIE0_RCHNG_RCGR) & 1u); i++) {
+		delay(10);
+	}
+	printf("ASUS WLAN: rchng RCG CMD %#x CFG %#x, aux RCG CMD %#x CFG %#x\n",
+	    rd(gcc, GCC_PCIE0_RCHNG_RCGR), rd(gcc, GCC_PCIE0_RCHNG_RCGR + 4),
+	    rd(gcc, GCC_PCIE_0_AUX_RCGR), rd(gcc, GCC_PCIE_0_AUX_RCGR + 4));
+
+	/* branch votes (all but the pipe clock), the reference clock to the PHY */
+	setbits(gcc, GCC_VOTE_1, (1u << 0) | (1u << 1) | (1u << 2) | (1u << 3) | (1u << 5), 0);
+	setbits(gcc, GCC_VOTE_0, (1u << 11) | (1u << 12) | (1u << 18) | (1u << 19) | (1u << 22), 0);
+	setbits(gcc, GCC_PCIE_0_CLKREF_EN, 1u, 0);
+	bool clocks = gcc_branch_on("slv_axi", GCC_PCIE_0_SLV_CBCR) &
+	    gcc_branch_on("slv_q2a", GCC_PCIE_0_SLV_Q2A_CBCR) &
+	    gcc_branch_on("cfg_ahb", GCC_PCIE_0_CFG_AHB_CBCR) &
+	    gcc_branch_on("aux", GCC_PCIE_0_AUX_CBCR) &
+	    gcc_branch_on("rchng", GCC_PCIE0_RCHNG_CBCR);
+	printf("ASUS WLAN: votes %#x / %#x, mstr CBCR %#x, clkref %#x, clocks %s\n",
+	    rd(gcc, GCC_VOTE_0), rd(gcc, GCC_VOTE_1), rd(gcc, GCC_PCIE_0_MSTR_CBCR),
+	    rd(gcc, GCC_PCIE_0_CLKREF_EN), clocks ? "on" : "NOT all on");
+	if (!clocks) {
+		return;
+	}
+
+	/* block resets: controller and PHY */
+	wr(gcc, GCC_PCIE_0_BCR, 1);
+	wr(gcc, GCC_PCIE_0_PHY_BCR, 1);
+	delay(1000);
+	wr(gcc, GCC_PCIE_0_PHY_BCR, 0);
+	wr(gcc, GCC_PCIE_0_BCR, 0);
+	delay(1000);
+
+	/* PARF (qcom_pcie_init_2_7_0) */
+	wr(parf, PARF_DEVICE_TYPE, DEVICE_TYPE_RC);
+	setbits(parf, PARF_PHY_CTRL, 0, PHY_TEST_PWR_DOWN);
+	wr(parf, PARF_DBI_BASE_ADDR_V2, 0);
+	setbits(parf, PARF_SYS_CTRL, 0, MAC_PHY_POWERDOWN_IN_P2_D_MUX_EN);
+	setbits(parf, PARF_MHI_CLOCK_RESET_CTRL, MHI_BYPASS, 0);
+	setbits(parf, PARF_PM_CTRL, 0, REQ_NOT_ENTR_L1);
+	wr(parf, PARF_SLV_ADDR_SPACE_SIZE_V2, 0x04000000);      /* DT qcom,slv-addr-space-size */
+	setbits(parf, PARF_AXI_MSTR_WR_ADDR_HALT_V2, 1u << 31, 0);
+	printf("ASUS WLAN: PARF SYS_CTRL %#x PM_CTRL %#x PHY_CTRL %#x LTSSM %#x DEVICE_TYPE %#x\n",
+	    rd(parf, PARF_SYS_CTRL), rd(parf, PARF_PM_CTRL), rd(parf, PARF_PHY_CTRL),
+	    rd(parf, PARF_LTSSM), rd(parf, PARF_DEVICE_TYPE));
+
+	/* QMP PHY: the DT sequence (power down control 3 first, SW reset 0 / start 3 last) */
+	for (unsigned i = 0; i < sizeof(wl_phy_seq) / sizeof(wl_phy_seq[0]); i++) {
+		wr(phy, wl_phy_seq[i].off, wl_phy_seq[i].val);
+		if (wl_phy_seq[i].delay_us) {
+			delay(wl_phy_seq[i].delay_us);
+		}
+	}
+	delay(1000);
+	/* the pipe clock: GCC mux to the PHY's output, then the branch */
+	wr(gcc, GCC_PCIE_0_PIPE_MUXR, 0);
+	setbits(gcc, GCC_VOTE_1, 1u << 4, 0);
+	bool ready = false;
+	for (int i = 0; i < 1000 && !ready; i++) {
+		ready = !(rd(phy, PHY_PCS_STATUS) & PHYSTATUS);
+		if (!ready) {
+			delay(100);
+		}
+	}
+	printf("ASUS WLAN: PHY %s (PCS status %#x), pipe CBCR %#x mux %#x\n", ready ? "ready" : "NOT ready",
+	    rd(phy, PHY_PCS_STATUS), rd(gcc, GCC_PCIE_0_PIPE_CBCR), rd(gcc, GCC_PCIE_0_PIPE_MUXR));
+	if (!ready) {
+		return;
+	}
+
+	/* root port: DBI header */
+	printf("ASUS WLAN: root port %#x class %#x, header %#x, BAR0 %#x\n", rd(dbi, 0x00), rd(dbi, 0x08),
+	    rd(dbi, 0x0c), rd(dbi, 0x10));
+	wr(dbi, 0x8bc, rd(dbi, 0x8bc) | 1u);            /* MISC_CONTROL_1: DBI_RO_WR_EN */
+	wr(dbi, 0x10, 0);
+	wr(dbi, 0x14, 0);
+	wr(dbi, 0x18, 0x00010100);                      /* primary 0, secondary 1, subordinate 1 */
+	wr(dbi, 0x04, rd(dbi, 0x04) | 0x0006);          /* memory space, bus master */
+	wr(dbi, 0x8bc, rd(dbi, 0x8bc) & ~1u);
+	uint32_t pcie_cap = dbi_find_cap(dbi, 0x10);
+
+	/* PERST: at least 100 ms after the rails and WLAN_EN (they came up before this) */
+	uint64_t now, ms;
+	absolutetime_to_nanoseconds(mach_absolute_time() - t0, &now);
+	ms = now / NSEC_PER_MSEC;
+	if (ms < 100) {
+		wl_sleep_ms((unsigned)(100 - ms));
+	}
+	gpio_out(GPIO_PERST, 1, 2, CFG_PULL_DOWN);
+	delay(1500);
+
+	/* link training */
+	setbits(parf, PARF_LTSSM, LTSSM_EN, 0);
+	uint32_t last = ~0u, lnk = 0;
+	bool up = false;
+	for (int i = 0; i < 200 && !up; i++) {         /* up to 1 s */
+		uint32_t st = rd(parf, PARF_LTSSM) & 0x3f;
+		if (st != last) {
+			printf("ASUS WLAN: LTSSM state %#x after %d ms\n", st, i * 5);
+			last = st;
+		}
+		lnk = pcie_cap ? rd(dbi, pcie_cap + 0x10) : 0;  /* LNKCTL | LNKSTA << 16 */
+		up = (rd(dbi, ELBI_OFF + ELBI_SYS_STTS) & XMLH_LINK_UP) && (lnk & (1u << 29));
+		if (!up) {
+			wl_sleep_ms(5);
+		}
+	}
+	printf("ASUS WLAN: link %s: LTSSM %#x ELBI_SYS_STTS %#x LNKSTA %#x (gen %u x%u), cap at %#x\n",
+	    up ? "UP" : "DOWN", rd(parf, PARF_LTSSM), rd(dbi, ELBI_OFF + ELBI_SYS_STTS), lnk >> 16,
+	    (lnk >> 16) & 0xf, (lnk >> 20) & 0x3f, pcie_cap);
+	if (!up) {
+		return;
+	}
+
+	/* iATU outbound region 0 (unrolled): CFG0 to bus 1, device 0 */
+	wr(atu, 0x08, (uint32_t)CONF_PA);
+	wr(atu, 0x0c, (uint32_t)(CONF_PA >> 32));
+	wr(atu, 0x10, (uint32_t)CONF_PA + CONF_SIZE - 1);
+	wr(atu, 0x14, 1u << 24);
+	wr(atu, 0x18, 0);
+	wr(atu, 0x00, 0x4);                             /* CFG0 */
+	wr(atu, 0x04, 1u << 31);                        /* enable */
+	for (int i = 0; i < 100 && !(rd(atu, 0x04) & (1u << 31)); i++) {
+		delay(10);
+	}
+	delay(10);
+	uint32_t id = rd(conf, 0x00);
+	printf("ASUS WLAN: endpoint 01:00.0 id %04x:%04x class %#x header %#x BAR0 %#x BAR1 %#x%s\n",
+	    id & 0xffff, id >> 16, rd(conf, 0x08), rd(conf, 0x0c), rd(conf, 0x10), rd(conf, 0x14),
+	    id == 0x110317cb ? " = QCA6490" : "");
+	if (id != 0x110317cb || wl_mode < 2) {
+		return;
+	}
+	wl_stage_b0(atu, conf);
+}
+
+static void
+wl_thread(void *arg __unused, wait_result_t wr_ __unused)
+{
+	int delay_s = 20;
+
+	PE_parse_boot_argn("asuswlandelay", &delay_s, sizeof(delay_s));
+	if (delay_s > 0) {
+		wl_sleep_ms((unsigned)delay_s * 1000);
+	}
+	tlmm = ml_io_map(TLMM_PA, TLMM_SIZE);
+	gcc = ml_io_map(GCC_PA, GCC_SIZE);
+	if (tlmm == 0 || gcc == 0) {
+		printf("ASUS WLAN: TLMM/GCC map failed\n");
+		return;
+	}
+	printf("ASUS WLAN: stage A: WLAN_EN %d SW_CTRL %d PERST %d CLKREQ cfg %#x\n", gpio_in(GPIO_WLAN_EN),
+	    gpio_in(GPIO_SW_CTRL), gpio_in(GPIO_PERST), rd(tlmm, GPIO_CFG(GPIO_CLKREQ)));
+	gpio_out(GPIO_PERST, 0, 2, CFG_PULL_DOWN);      /* endpoint held in reset */
+	if (!wl_power_rails()) {
+		printf("ASUS WLAN: rail votes failed, stop\n");
+		return;
+	}
+	wl_sleep_ms(10);
+	gpio_out(GPIO_BT_EN, 0, 2, CFG_PULL_DOWN);
+	gpio_out(GPIO_ANT_SW, 1, 2, CFG_PULL_UP);
+	gpio_out(GPIO_WLAN_EN, 1, 16, CFG_PULL_UP);
+	wr(tlmm, GPIO_CFG(GPIO_CLKREQ), CFG_FUNC(1) | CFG_DRV(2) | CFG_PULL_UP);   /* pcie0_clkreqn */
+	wr(tlmm, GPIO_CFG(GPIO_WAKE), CFG_FUNC(0) | CFG_DRV(2) | CFG_PULL_UP);     /* input */
+	for (int i = 0; i < 20; i++) {
+		wl_sleep_ms(10);
+		if (gpio_in(GPIO_SW_CTRL)) {
+			break;
+		}
+	}
+	printf("ASUS WLAN: WLAN_EN %d, SW_CTRL %d, WAKE %d\n", gpio_in(GPIO_WLAN_EN), gpio_in(GPIO_SW_CTRL),
+	    gpio_in(GPIO_WAKE));
+	wl_pcie_up();
+	printf("ASUS WLAN: stage A done\n");
+}
+
+/* Called once from sweet_ufs_init (bsd/dev/sweet_ufs.c). */
+void
+asus_wlan_start(void)
+{
+	int mode = 0;
+	thread_t thread;
+
+	PE_parse_boot_argn("asuswlan", &mode, sizeof(mode));
+	if (mode <= 0) {
+		return;
+	}
+	wl_mode = mode;
+	if (kernel_thread_start(wl_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
